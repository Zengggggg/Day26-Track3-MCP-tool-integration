# Default local stdio setup. Copy this file to .env and edit values as needed.
MCP_TRANSPORT=stdio
MCP_HOST=127.0.0.1
MCP_PORT=3001

# Leave empty for unauthenticated stdio. Set this for HTTP/SSE auth demos.
MCP_AUTH_TOKEN=

# Leave empty to use SQLite at implementation/lab.db.
# Set to postgresql://user:password@localhost:5432/sqlite_lab to use PostgreSQL.
DATABASE_URL=
POSTGRES_SCHEMA=public

